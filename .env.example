# Copy to .env.local and fill in. .env.local is gitignored — never commit a real
# value here (NFR-6, DC-8).

# --- MongoDB ---------------------------------------------------------------
# Connection string and database name, supplied by the supervisor.
MONGODB_URI=
MONGODB_DB=

# --- Auth.js ---------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth 2.0 client, from the GCP console.
# Authorised redirect URI must be:
#   http://localhost:3000/api/auth/callback/google        (local)
#   https://<your-domain>/api/auth/callback/google        (deployed)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Required in production only; inferred from the request during local dev.
# AUTH_URL=https://<your-domain>

# --- Seeding ---------------------------------------------------------------
# The Google account of the first OFFICE_ADMIN. Its domain becomes the
# authorised Workspace domain for sign in, so `npm run seed` refuses to run
# without it rather than guessing one and locking everybody out.
SEED_ADMIN_EMAIL=
