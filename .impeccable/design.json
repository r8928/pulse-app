  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one action a screen exists for. Never two on the same screen.",
      "html": "<button class=\"ds-btn-primary\">New user</button>",
      "css": ".ds-btn-primary { background: #b54708; color: #ffffff; font-family: Inter, system-ui, sans-serif; font-size: 0.875rem; font-weight: 500; text-transform: none; padding: 4px 10px; border: none; border-radius: 6px; box-shadow: none; cursor: pointer; transition: background 0.2s; } .ds-btn-primary:hover { background: #92400e; } .ds-btn-primary:focus-visible { outline: 2px solid #c2410c; outline-offset: 2px; border-radius: 3px; } .ds-dark .ds-btn-primary { background: #f0883e; color: #0d1117; } .ds-dark .ds-btn-primary:hover { background: #ffa657; }"
    },
    {
      "name": "Outlined Button",
      "kind": "button",
      "refersTo": "button-outlined",
      "description": "Secondary actions such as Sign out.",
      "html": "<button class=\"ds-btn-outlined\">Sign out</button>",
      "css": ".ds-btn-outlined { background: #ffffff; color: #b54708; font-family: Inter, system-ui, sans-serif; font-size: 0.875rem; font-weight: 500; text-transform: none; padding: 3px 9px; border: 1px solid rgba(181, 71, 8, 0.5); border-radius: 6px; cursor: pointer; transition: background 0.2s, border-color 0.2s; } .ds-btn-outlined:hover { background: #fdf0e6; border-color: #b54708; } .ds-btn-outlined:focus-visible { outline: 2px solid #c2410c; outline-offset: 2px; border-radius: 3px; } .ds-dark .ds-btn-outlined { background: #161b22; color: #f0883e; border-color: rgba(240, 136, 62, 0.5); } .ds-dark .ds-btn-outlined:hover { background: #2d1e12; border-color: #f0883e; }"
    },
    {
      "name": "Appearance Toggle",
      "kind": "button",
      "refersTo": "button-appearance-toggle",
      "description": "Cycles system, light and dark. The mode is named in the accessible name, never signalled by the icon alone.",
      "html": "<button class=\"ds-appearance\" aria-label=\"Appearance: Light. Switch to dark.\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 7a5 5 0 100 10 5 5 0 000-10zM2 13h2a1 1 0 000-2H2a1 1 0 000 2zm18 0h2a1 1 0 000-2h-2a1 1 0 000 2zM11 2v2a1 1 0 002 0V2a1 1 0 00-2 0zm0 18v2a1 1 0 002 0v-2a1 1 0 00-2 0z\"/></svg></button>",
      "css": ".ds-appearance { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; background: transparent; color: #5a6472; border: none; border-radius: 50%; cursor: pointer; transition: background 0.2s, color 0.2s; } .ds-appearance:hover { background: #f1f3f6; color: #1a1f26; } .ds-appearance:focus-visible { outline: 2px solid #c2410c; outline-offset: 2px; border-radius: 3px; } .ds-dark .ds-appearance { color: #9198a1; } .ds-dark .ds-appearance:hover { background: #1c2128; color: #e6edf3; }"
    },
    {
      "name": "Status Chip — Success",
      "kind": "chip",
      "refersTo": "chip-status-success",
      "description": "Status never travels by colour alone: the icon and the word are both required.",
      "html": "<span class=\"ds-chip-success\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 2a10 10 0 100 20 10 10 0 000-20zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg>Active</span>",
      "css": ".ds-chip-success { --status-icon-gap: 6px; display: inline-flex; align-items: center; height: 24px; padding: 0 8px; font-family: Inter, system-ui, sans-serif; font-size: 0.8125rem; font-weight: 600; color: #145a32; background: #e7f6ea; border: 1px solid #9fd6ac; border-radius: 6px; } .ds-chip-success svg { margin-inline-end: var(--status-icon-gap); color: inherit; } .ds-dark .ds-chip-success { color: #56d364; background: #132b1c; border-color: #2f6b3a; }"
    },
    {
      "name": "Status Chip — Warning",
      "kind": "chip",
      "refersTo": "chip-status-warning",
      "description": "Yellow, not amber. The action colour is orange, and a warning must never read as a button.",
      "html": "<span class=\"ds-chip-warning\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z\"/></svg>Needs attention</span>",
      "css": ".ds-chip-warning { --status-icon-gap: 6px; display: inline-flex; align-items: center; height: 24px; padding: 0 8px; font-family: Inter, system-ui, sans-serif; font-size: 0.8125rem; font-weight: 600; color: #6b4a00; background: #fff8e1; border: 1px solid #ffd54f; border-radius: 6px; } .ds-chip-warning svg { margin-inline-end: var(--status-icon-gap); color: inherit; } .ds-dark .ds-chip-warning { color: #e3b341; background: #2a2211; border-color: #6b5327; }"
    },
    {
      "name": "Status Chip — Neutral",
      "kind": "chip",
      "refersTo": "chip-status-neutral",
      "description": "Not tracked, no longer active, or disabled.",
      "html": "<span class=\"ds-chip-neutral\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M19 13H5v-2h14v2z\"/></svg>Not tracked</span>",
      "css": ".ds-chip-neutral { --status-icon-gap: 6px; display: inline-flex; align-items: center; height: 24px; padding: 0 8px; font-family: Inter, system-ui, sans-serif; font-size: 0.8125rem; font-weight: 600; color: #41474f; background: #eef0f3; border: 1px solid #cdd2d9; border-radius: 6px; } .ds-chip-neutral svg { margin-inline-end: var(--status-icon-gap); color: inherit; } .ds-dark .ds-chip-neutral { color: #adb6c0; background: #21262d; border-color: #444c56; }"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input-text",
      "description": "Dense by default. Every labelled field keeps its label visible.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Employee code</span><input class=\"ds-field-input\" value=\"CB-0142\" /></label>",
      "css": ".ds-field { display: inline-flex; flex-direction: column; gap: 4px; } .ds-field-label { font-family: Inter, system-ui, sans-serif; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: #5a6472; } .ds-field-input { font-family: JetBrains Mono, ui-monospace, monospace; font-size: 0.8125rem; font-variant-numeric: tabular-nums lining-nums; padding: 8px 10px; color: #1a1f26; background: #ffffff; border: 1px solid #c3cad3; border-radius: 6px; } .ds-field-input:focus-visible { outline: 2px solid #c2410c; outline-offset: 2px; border-radius: 3px; border-color: #b54708; } .ds-dark .ds-field-label { color: #9198a1; } .ds-dark .ds-field-input { color: #e6edf3; background: #161b22; border-color: #444c56; }"
    },
    {
      "name": "Navigation Item",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "The current item is marked by tint and by aria-current, because a tinted background alone is colour-only signalling.",
      "html": "<a class=\"ds-nav-item ds-nav-item-current\" href=\"#\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z\"/></svg>People</a>",
      "css": ".ds-nav-item { display: flex; align-items: center; gap: 12px; padding: 8px 16px; font-family: Inter, system-ui, sans-serif; font-size: 0.875rem; color: #1a1f26; text-decoration: none; border-radius: 6px; transition: background 0.2s; } .ds-nav-item:hover { background: #f1f3f6; } .ds-nav-item:focus-visible { outline: 2px solid #c2410c; outline-offset: 2px; border-radius: 3px; } .ds-nav-item-current { background: #fdf0e6; color: #b54708; font-weight: 600; } .ds-dark .ds-nav-item { color: #e6edf3; } .ds-dark .ds-nav-item:hover { background: #1c2128; } .ds-dark .ds-nav-item-current { background: #2d1e12; color: #f0883e; }"
    },
    {
      "name": "Data Table",
      "kind": "card",
      "refersTo": "table-data",
      "description": "The archetype screen. Dense rows, tabular figures, a recessed header strip, separated by rules rather than shadow.",
      "html": "<table class=\"ds-table\"><thead><tr><th>Name</th><th>Employee code</th><th>Hours</th></tr></thead><tbody><tr><td>Amara Okafor</td><td class=\"ds-num\">CB-0142</td><td class=\"ds-num\">8.25</td></tr><tr><td>Ravi Menon</td><td class=\"ds-num\">CB-0143</td><td class=\"ds-num\">7.50</td></tr></tbody></table>",
      "css": ".ds-table { border-collapse: collapse; font-family: Inter, system-ui, sans-serif; font-size: 0.875rem; color: #1a1f26; background: #ffffff; border: 1px solid #dfe3e8; border-radius: 6px; overflow: hidden; } .ds-table th { text-align: left; padding: 8px 12px; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: #5a6472; background: #f1f3f6; border-bottom: 1px solid #dfe3e8; } .ds-table td { padding: 8px 12px; border-bottom: 1px solid #dfe3e8; } .ds-table tr:last-child td { border-bottom: none; } .ds-num { font-family: JetBrains Mono, ui-monospace, monospace; font-size: 0.8125rem; font-variant-numeric: tabular-nums lining-nums; } .ds-dark .ds-table { color: #e6edf3; background: #161b22; border-color: #30363d; } .ds-dark .ds-table th { color: #9198a1; background: #1c2128; border-bottom-color: #30363d; } .ds-dark .ds-table td { border-bottom-color: #30363d; }"
    },
    {
      "name": "Metric Tile",
      "kind": "card",
      "refersTo": "tile-metric",
      "description": "A figure and the label that says what it means. The label is quieter than the value it introduces.",
      "html": "<div class=\"ds-tile\"><span class=\"ds-tile-label\">Hours this week</span><p class=\"ds-tile-value\">37.25</p></div>",
      "css": ".ds-tile { display: flex; flex-direction: column; gap: 8px; padding: 16px; background: #ffffff; border: 1px solid #dfe3e8; border-radius: 6px; } .ds-tile-label { font-family: Inter, system-ui, sans-serif; font-size: 0.75rem; font-weight: 600; line-height: 1.4; letter-spacing: 0.04em; text-transform: uppercase; color: #5a6472; } .ds-tile-value { margin: 0; font-family: Inter, system-ui, sans-serif; font-size: 1.75rem; font-weight: 640; line-height: 1.15; font-variant-numeric: tabular-nums lining-nums; color: #1a1f26; } .ds-dark .ds-tile { background: #161b22; border-color: #30363d; } .ds-dark .ds-tile-label { color: #9198a1; } .ds-dark .ds-tile-value { color: #e6edf3; }"
