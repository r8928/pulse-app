    "typographyMeta": {
      "page-title": {
        "displayName": "Page Title",
        "purpose": "The screen name. One per screen. Renders as h1."
      },
      "section-title": {
        "displayName": "Section Title",
        "purpose": "A panel or card heading, and the app name in the AppBar. Renders as h2."
      },
      "metric-label": {
        "displayName": "Metric Label",
        "purpose": "Uppercase caption above a figure or a chip group. Renders as span."
      },
      "metric-value": {
        "displayName": "Metric Value",
        "purpose": "The figure itself, in tabular numerals. The largest type in the system. Renders as p."
      },
      "mono": {
        "displayName": "Mono",
        "purpose": "Employee codes, dates, durations and balances, so columns align. Renders as code."
      },
      "body-strong": {
        "displayName": "Body Strong",
        "purpose": "An emphasised value inside running text. Renders as strong."
      }
    },
